@model IEnumerable<AirportOpsMVC.Dto.Terminal.ResponseTerminalDto>

    <h2>Terminal Dashboard</h2>
    <table class="table">
      <thead>
          <tr>
              <th>Id</th>
              <th>AirportId</th>
              <th>Name</th>
              <th>IsActive</th>
              <th>Actions</th>
          </tr>
      </thead>
      <tbody>
        @foreach (var Terminal in Model)
        {
            <tr>
                <td>@Terminal.Id</td>
                <td>@Terminal.AirportId</td>
                <td>@Terminal.Name</td>
                <td>@Terminal.IsActive</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@Terminal.Id" class="btn btn-warning">Edit</a>
                       <a asp-action="Delete"
                       asp-route-id="@Terminal.Id" class="btn btn-warning">Delete</a>
                </td>
            </tr>


        }
    </tbody>
        
    </table>